# Cashflow local config. Copy to .env — NEVER commit .env.
# cp env.example .env

# --- Server ---
PORT=8080
ENV=development

# --- Database ---
# Used by docker-compose to create the Postgres container.
POSTGRES_USER=cashflow
POSTGRES_PASSWORD=cashflow_local_dev
POSTGRES_DB=cashflow
POSTGRES_PORT=5432
# Used by the Go backend to connect. Matches the values above for local Docker use.
DATABASE_URL=postgres://cashflow:cashflow_local_dev@localhost:5432/cashflow?sslmode=disable

# --- Auth (Phase 2) ---
# Generate: openssl rand -base64 32 — required outside development, never commit a real value.
JWT_SIGNING_KEY=

# --- AI receipt scanning (Phase 4) ---
# Server-side only — never embed these in the Flutter app. See docs/adr/0002-ai-receipt-scanning.md.
# Provider: Gemini's OpenAI-compatibility layer — live-verified 2026-09-13 to
# correctly read a real receipt photo (merchant/date/total/line items all
# correct). Get a key at https://aistudio.google.com/apikey. Without a real
# AI_API_KEY, POST /receipts/scan responds 503 rather than failing to start.
# Uses the "-latest" model alias, not a pinned version: a pinned model
# (gemini-2.5-flash) was deprecated mid-testing, so pinning is a real
# maintenance burden here, not a theoretical one.
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-flash-latest
RECEIPT_SCAN_DAILY_LIMIT_PER_USER=10

# --- Email / workspace invites (Phase 9) ---
# Server-side only. Without SMTP_PASSWORD, invite emails are logged instead of
# sent (mail.NoopMailer) — the app still works, invites just aren't delivered.
# SMTP_IMPLICIT_TLS defaults to true when SMTP_PORT=465 ("SslOnConnect") and
# false otherwise (e.g. 587/STARTTLS); set it explicitly to override that.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=Cashflow
# SMTP_IMPLICIT_TLS=true

# Where a workspace-invite link points the invitee (the mobile app / a web
# landing page owns the actual "/invites/{token}" route).
APP_BASE_URL=https://app.cashflow.example

# --- Admin dashboard (Phase 9d) ---
# Internal-only operator dashboard at GET /admin (HTTP Basic Auth). Empty
# ADMIN_USER/ADMIN_PASSWORD disables it entirely — it is never served
# unauthenticated. See docs/ops/production-deployment.md.
ADMIN_USER=
ADMIN_PASSWORD=
# Optional: a READ-ONLY connection string to the sibling gawean-management
# app's own Postgres, just to show its total user count on the same
# dashboard. Leave empty to show it as "not connected" — this project has
# no business reaching into another app's database without an explicit,
# narrowly-scoped read-only credential handed over for exactly this.
GAWEAN_DATABASE_URL=
# Where scripts/log-watch.py's error-log.jsonl is mounted inside the
# container (docker-compose.prod.yml) — the default matches that mount and
# should not normally need changing.
ADMIN_ERROR_LOG_PATH=/data/monitor/error-log.jsonl
